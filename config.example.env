# This standalone source showcase executes the deterministic, credential-free
# demonstration only. Keep this value as "demo": the bundled server explicitly
# rejects VSC_MODE=live because no live adapter is included.
VSC_MODE=demo

# The names below reserve a configuration schema for separately implemented
# adapters. They are documentation placeholders, not runnable integrations;
# setting them does not enable live behavior in this repository.
# Never place real credentials in this file or commit a populated environment.
# VSC_LIVE_MODEL_ENDPOINT=https://provider.example.invalid/v1
# VSC_LIVE_MODEL_TOKEN=<set-in-local-environment>
# VSC_LIVE_CARD_ENDPOINT=https://cards.example.invalid/v1
# VSC_LIVE_CARD_TOKEN=<set-in-local-environment>
