{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voice-study-companion:fixtures:voice-pipeline:v1:audio",
  "title": "Voice Study Companion synthetic audio corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "kind", "fixtures"],
  "properties": {
    "$schema": {"const": "audio.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"const": "audio_corpus"},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id", "card_fixture_id", "sample_rate_hz", "channels",
          "duration_ms", "expected_transcript", "labels", "recipe"
        ],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1},
          "card_fixture_id": {"type": "string", "minLength": 1},
          "sample_rate_hz": {"type": "integer", "minimum": 8000},
          "channels": {"enum": [1, 2]},
          "duration_ms": {"type": "integer", "minimum": 1, "maximum": 5000},
          "expected_transcript": {"type": "string", "minLength": 1},
          "labels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "recipe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "waveform", "frequency_hz", "amplitude", "noise_amplitude", "seed"
            ],
            "properties": {
              "waveform": {"enum": ["sine", "noise", "sine_noise"]},
              "frequency_hz": {"type": "number", "minimum": 0},
              "amplitude": {"type": "number", "minimum": 0, "maximum": 1},
              "noise_amplitude": {"type": "number", "minimum": 0, "maximum": 1},
              "seed": {"type": "integer"}
            }
          }
        }
      }
    }
  }
}
